datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TEACHER
  BUYER
  ADMIN
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String
  fullName  String
  role      Role        @default(BUYER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  worksheets Worksheet[] @relation("TeacherWorksheets")
  orders    Order[]
  sessions  Session[]
}

// A login creates a row here and the token carries its id. Auth is decided by
// this row, not by the token alone, so logout can end a session server-side.
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Worksheet {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  description String
  price       Decimal     @db.Decimal(10, 2)
  gradeLevel  String
  subject     String
  s3Key       String
  fileUrl     String
  authorId    String
  author      User        @relation("TeacherWorksheets", fields: [authorId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  paymentIntentId String?  @unique
  items       OrderItem[]
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worksheetId String
  worksheet   Worksheet @relation(fields: [worksheetId], references: [id])
  price       Decimal   @db.Decimal(10, 2)
}
