# Copy to .env and fill in. Never commit real values.

# --- Auth ---
# Two different long random strings (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# Production behind the UI's /api proxy (Vercel rewrites to Render): lax + true + /api.
# Local development, UI calling the API directly: leave all three unset
# (defaults: strict, secure only in production, no prefix).
COOKIE_SAME_SITE=
COOKIE_SECURE=
COOKIE_PATH_PREFIX=
# Google sign-in: OAuth "Web application" client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# --- Server ---
DATABASE_URL=
PORT=3001
# The UI's origin, used for CORS. Exact match, no trailing slash.
CLIENT_URL=http://localhost:3000

# --- AWS S3 ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
